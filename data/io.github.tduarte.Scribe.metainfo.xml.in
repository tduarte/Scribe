<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.tduarte.Scribe</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Scribe</name>
  <summary>Dictate anywhere with your voice</summary>

  <developer id="io.github.tduarte">
    <name>Tiago Duarte</name>
  </developer>

  <description>
    <p>
      Speak, and Scribe writes it down. Hold a keyboard shortcut anywhere on
      your desktop, say what you want to write, and let go — the words appear
      in whatever you were already typing into, whether that is an email, a
      chat window, or your editor.
    </p>
    <p>
      It is quicker than typing for anything longer than a sentence, and it
      keeps up with natural speech rather than making you dictate word by
      word. If your hands are busy, sore, or simply slower than your thoughts,
      you can talk instead.
    </p>
    <p>
      Everything happens on your own computer. Your voice is never uploaded
      and never stored on anyone else's server, so Scribe keeps working with
      no internet connection at all.
    </p>
    <p>Scribe can:</p>
    <ul>
      <li>Write into any application, not only ones built for dictation</li>
      <li>Work out which language you are speaking, and write it down as you said it</li>
      <li>Turn what you say into English instead, if you ask it to</li>
      <li>Ignore your pauses, and tidy away the ums and uhs</li>
      <li>Learn names and jargon it would otherwise get wrong</li>
      <li>Keep a searchable record of what you have dictated, or none at all</li>
      <li>Use your graphics card, so longer passages come back in a moment</li>
    </ul>
  </description>

  <launchable type="desktop-id">io.github.tduarte.Scribe.desktop</launchable>

  <url type="homepage">https://github.com/tduarte/Scribe</url>
  <url type="bugtracker">https://github.com/tduarte/Scribe/issues</url>
  <url type="vcs-browser">https://github.com/tduarte/Scribe</url>

  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/tduarte/Scribe/main/data/screenshots/main.png</image>
      <caption>Dictating into a text editor</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/tduarte/Scribe/main/data/screenshots/models.png</image>
      <caption>Choosing a speech recognition model</caption>
    </screenshot>
  </screenshots>

  <branding>
    <color type="primary" scheme_preference="light">#f9dfc4</color>
    <color type="primary" scheme_preference="dark">#40260f</color>
  </branding>

  <content_rating type="oars-1.1"/>

  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <recommends>
    <control>keyboard</control>
    <control>pointing</control>
  </recommends>

  <translation type="gettext">scribe</translation>

  <releases>
    <release version="0.1.0" date="2026-08-28">
      <description>
        <p>First release.</p>
        <ul>
          <li>Hold a shortcut anywhere, speak, and release to insert the text</li>
          <li>Transcription runs on your own machine, with Vulkan acceleration</li>
          <li>Works entirely offline once a model has been downloaded</li>
          <li>Choose from several Whisper models, from 32 MB up to 874 MB</li>
          <li>Recent dictations are capped, and anything older is erased rather than hidden</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
